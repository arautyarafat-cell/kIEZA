# ========================================================
# CONFIGURAÇÕES DE AMBIENTE - KIEZA APP
# Copie este arquivo para .env e preencha com seus dados reais
# ========================================================

# Porta do Servidor Backend (Render e VPS preenchem automaticamente)
PORT=5000

# Chave Secreta para Tokens JWT (use uma string longa e aleatória em produção)
JWT_SECRET=coloque_uma_chave_secreta_longa_e_segura_aqui_exemplo_32_caracteres

# Configurações do Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=kieza_db
DB_PORT=3306

# Se o banco em nuvem exigir SSL (TiDB Cloud, Aiven, etc.), mude para true
DB_SSL=false

# Diretório customizado para uploads (opcional, útil para Render Disk ou volume montado)
# UPLOADS_DIR=/var/data/uploads

# URL da API para o Frontend (React)
# Em desenvolvimento: http://localhost:5000
# Em produção no mesmo domínio/servidor VPS/Render: deixe vazio
REACT_APP_API_URL=
